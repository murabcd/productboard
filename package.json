{
  "name": "productboard",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "bun run check:lat && bun run check:konsistent && biome check && tsc --noEmit && bun test",
    "check:lat": "lat check",
    "check:konsistent": "bun run konsistent",
    "konsistent": "konsistent"
  },
  "dependencies": {
    "@opentui/core": "0.8.3",
    "eve": "0.82.0",
    "just-bash": "3.1.0",
    "marked": "17.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "konsistent": "1.0.0-beta.9",
    "lat.md": "0.12.2",
    "typescript": "7.0.2"
  }
}
